# Target GentleBook application for links from the marketing website.
# Use the staging app URL in the Vercel Staging environment and the live app
# URL in Production.
NEXT_PUBLIC_GENTLEBOOK_APP_URL=http://localhost:3000

# SMTP credentials used to notify the sales team about contact/demo/trial form
# submissions (src/lib/leadMail.ts). Without these, leads are only logged to
# the server console, not emailed — set all three before going live.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Mailbox that receives lead notifications (defaults to info@gentlebook.de).
LEADS_TO_EMAIL=
